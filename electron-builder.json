{
  "appId": "com.doujin.menu.app",
  "productName": "동인메뉴판",
  "directories": {
    "output": "dist",
    "buildResources": "src/main/static"
  },
  "win": {
    "target": ["nsis"]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "doujin-menu-setup-${version}.${ext}",
    "shortcutName": "동인메뉴판"
  },
  "portable": {
    "artifactName": "doujin-menu-portable-${version}.${ext}"
  },
  "linux": {
    "target": ["snap"]
  },
  "asar": true,
  "publish": {
    "provider": "github",
    "owner": "qqoro",
    "repo": "doujin-menu"
  },
  "files": [
    "build/main/**/*",
    "build/renderer/**/*",
    "package.json",
    "!node_modules/better-sqlite3/{deps,src}",
    "!node_modules/better-sqlite3/prebuilds/{darwin-arm64,darwin-x64,linux-arm64,linux-x64,linuxmusl-arm64,linuxmusl-x64}.node"
  ],
  "extraResources": [
    {
      "from": "src/main/static",
      "to": "static",
      "filter": ["**/*"]
    },
    {
      "from": "build/main/migrations",
      "to": "migrations",
      "filter": ["**/*"]
    }
  ]
}
