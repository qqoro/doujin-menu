{
  "name": "doujin-menu",
  "displayName": "동인메뉴판",
  "version": "1.26.0",
  "description": "만화책 관리를 위한 데스크톱 어플리케이션",
  "license": "MIT",
  "main": "build/main/main/main.js",
  "author": {
    "name": "qqoro"
  },
  "scripts": {
    "dev": "node scripts/dev-server.js",
    "build": "vue-tsc --noEmit && node scripts/build.js && electron-builder --win --publish=never",
    "build:port": "vue-tsc --noEmit && node scripts/build.js && electron-builder --win portable --publish=never",
    "build:win": "vue-tsc --noEmit && node scripts/build.js && electron-builder --win --publish=never",
    "build:port:win": "vue-tsc --noEmit && node scripts/build.js && electron-builder --win portable --publish=never",
    "prepare": "husky",
    "format": "prettier --write src",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts",
    "lint:fix": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:series": "vitest run tests/unit/main/seriesDetector.test.ts",
    "test:coverage": "vitest run --coverage"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/solar": "^1.2.10",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@iconify/vue": "^5.0.1",
    "@internationalized/date": "^3.12.4",
    "@lucide/vue": "^1.43.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-query": "^5.102.8",
    "@tanstack/vue-table": "^9.2.4",
    "@tanstack/vue-virtual": "^3.13.37",
    "@types/archiver": "^8.0.0",
    "@types/node": "^26.5.0",
    "@types/semver": "^7.8.0",
    "@types/yauzl": "^3.4.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.0",
    "@vueuse/core": "^14.4.0",
    "chalk": "^6.0.0",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "license-checker-rseidelsohn": "^5.0.1",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.0.3",
    "pretendard": "^1.3.9",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "reka-ui": "^2.10.4",
    "shadcn-vue": "^2.8.2",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue": "^3.5.42",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "5",
    "vue-sonner": "^2.0.9",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.3",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "electron-window-state": "^5.0.3",
    "fast-glob": "^3.3.3",
    "filenamify": "^7.0.3",
    "knex": "^3.3.0",
    "node-hitomi": "^9.2.0",
    "p-queue": "^9.3.3",
    "semver": "^7.8.5",
    "sharp": "^0.35.4",
    "yauzl": "^3.4.0"
  },
  "packageManager": "pnpm@12.3.4"
}
